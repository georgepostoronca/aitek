extends ../layouts/default
include ../helpers/mixins

block variables
  - const title = "work"

block content
    #wrapper.page-work
        - var menuFixed = "--sticky"
        include ../../blocks/modules/menu/menu

        main
            - var vcncyblockTitle = "Работа в АйТек"
            include ../../blocks/modules/vcncyblock/vcncyblock
            include ../../blocks/modules/gridimg/gridimg

            section.section.blockblue(class="--silver")
                .container-fluid
                    .section__wrap.blockblue__wrap
                        .section__head.blockblue__content
                            h2 Улучшить кибербезопасность
                                br
                                | компаний
                            p Хамбакер неравномерен. Плавно-мобильное голосовое поле просветляет резкий голос. Развивая эту тему, глиссандо заканчивает деструктивный алеаторически выстроенный бесконечный канон с полизеркальной векторно-голосовой

            - var sliderTitle = "Текущие вакансии";
            include ../../blocks/modules/currvcncy/currvcncy

            include ../../blocks/modules/benefits/benefits

        include ../../blocks/modules/footer/footer

block scripts
    script(src="js/main.js")
    script(src="js/vendor.js")
