extends ../layouts/default
include ../helpers/mixins

block variables
  - const title = "detail"

block content
    #wrapper
      - var menuFixed = "--sticky"
      include ../../blocks/modules/menu/menu

      main
          include ../../blocks/modules/detail/detail

          - var sliderTitle = "Другие проекты"
          - var sliderClass = "--bg-silver"
          include ../../blocks/modules/slidermin/slidermin
          include ../../blocks/modules/blockblue/blockblue

      include ../../blocks/modules/footer/footer

block scripts
    script(src="js/main.js")
    script(src="js/vendor.js")
