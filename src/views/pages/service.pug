extends ../layouts/default
include ../helpers/mixins

block variables
  - const title = "service"

block content
  #wrapper
    - var menuFixed = "--sticky"
    include ../../blocks/modules/menu/menu

    main
      section.service
        .container-fluid
          .content__top
            ul.breadcrumbs.breadcrumbs-mb35
              li.breadcrumbs__item
                a.breadcrumbs__link(href="/")
                  span Главная

              li.breadcrumbs__item
                a.breadcrumbs__link
                  span Услуги

      include ../../blocks/modules/headerbg/headerbg

      - var sliderTitle = "Реализованные проекты"
      - var sliderClass = "--page-service"
      include ../../blocks/modules/slidermin/slidermin

      - var advantageClass = "--page-service"
      include ../../blocks/modules/advantage/advantage

      - var cybercomClass = "--page-service"
      include ../../blocks/modules/cybercom/cybercom

      - var improvecyberClass = "--page-service"
      include ../../blocks/modules/improvecyber/improvecyber

      - var projectClass = "--page-service"
      include ../../blocks/modules/project/project
      include ../../blocks/modules/photogallery/photogallery
      include ../../blocks/modules/blockblue/blockblue
      include ../../blocks/modules/blockvideo/blockvideo

  include ../../blocks/modules/footer/footer

block scripts
  script(src="js/main.js")
  script(src="js/vendor.js")
