section.vacancy.js-vacancy.--content-center(class=vacancyClass)
    .container-fluid
        //- .content__top
        //-     ul.breadcrumbs
        //-         li.breadcrumbs__item
        //-             a.breadcrumbs__link(href="/")
        //-                 span Главная

        //-         li.breadcrumbs__item
        //-             a.breadcrumbs__link(href="/vacancy.html")
        //-                 span Вакансии

        //-         li.breadcrumbs__item
        //-             a.breadcrumbs__link
        //-                 span Менеджер по работе с клиентами
                        
        .vacancy__wrap.js-vacancy-wrap
            .vacancy-detail.active.js-vacancy-detail(id="detail-" + i)
                .vacancy-detail__item
                    .vacancy-detail__back
                        a(href="#").link-arrow.js-vacancy-detail-close.--arrow-rotate
                            +svg("arrowline")
                            span Вернуться к списку

                    .vacancy-detail__info
                        h2 Менеджер по работе с клиентами (оформление документов) #{i}

                        .price
                            em Зарплата от
                            b 55 000₽

                        .vacancy-detail__tab.js-tab
                            .vacancy-detail__tab-head
                              each text,index in ["Требования", "Обязанности", "Условия"]
                                  button.js-tab-btn(data-text=text class=index === 0 ? 'active' : '')
                                      span=text

                            .vacancy-detail__tab-content
                              each i in [1,2,3,4]
                                  .vacancy-detail__tab-item.js-tab-content(class=i === 1 ? 'active' : '')
                                      ul
                                          li=i
                                          li Подготовка типовых коммерческих предложений;
                                          li Оформление договоров;
                                          li Размещение в заказах оплаченных счетов, контроль счетов, готовых к отгрузке;
                                          li Формирование финансовых, складских документов, сопровождающих
                                          li отгрузку товара;
                                          li Создание доставок в базе 1С;
                                          li Оформление пакета необходимых документов для участия в конкурсах в соответствии с требованиями конкурсной документации, подача заявок;
                                          li Контроль сроков подачи заявок на участие в конкурсе, сроков оплаты
                                          li обеспечения исполнения заявки;
                                          li Запрос справок у проверяющих органов;
                                          li Контроль отгрузки товара, контроль возврата финансовых документов.

                                      footer
                                          h4 Работайте с нами
                                          p Отправляйте заполненную анкету для соискателей на электронный адрес
                                              a() info@aitek.ru
                                              | , тел.
                                              a(href="tel:+7(495)755-65-56") +7 (495) 755-65-56 доб. 6815.
                                              | Наша служба персонала внимательно рассмотрит резюме и свяжется с вами.

                                          .btn.--max
                                              span Отправьте ваше резюме
