section.section.slidermin(class=projectClass)
  .container-fluid
    .section__wrap.slidermin__wrap
      .section__head
        h2 Реализованные проекты

        .swiper-container.slidermin__slider.js-slidermin.js-lightbox
          .swiper-wrapper
            .swiper-slide
              a(href="#").article.--min
                picture
                  span Проект один
                  img(src="img/project.jpg" srcset="img/project@2x.png" alt="IMG")

            .swiper-slide
              a(href="#").article.--min
                picture
                  span Проект второй
                  img(src="img/project.jpg" srcset="img/project@2x.png" alt="IMG")

            .swiper-slide
              a(href="#").article.--min
                picture
                  span Проект третий
                  img(src="img/project.jpg" srcset="img/project@2x.png" alt="IMG")

            .swiper-slide
              a(href="#").article.--min
                picture
                  span Проект третий
                  img(src="img/project.jpg" srcset="img/project@2x.png" alt="IMG")

            .swiper-slide
              a(href="#").article.--min
                picture
                  span Проект третий
                  img(src="img/project.jpg" srcset="img/project@2x.png" alt="IMG")

            .swiper-slide
              a(href="#").article.--min
                picture
                  span Проект третий
                  img(src="img/project.jpg" srcset="img/project@2x.png" alt="IMG")

          .swiper-pagination
          .swiper-button-prev
            +svg("arrowline")
            span Назад

          .swiper-button-next
            span Далее
            +svg("arrowline")
