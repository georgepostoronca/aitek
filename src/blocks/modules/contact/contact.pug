section.contact
  .container-fluid
    //- .content__top
    //-   ul.breadcrumbs
    //-     li.breadcrumbs__item
    //-       a.breadcrumbs__link(href="/")
    //-         span Главная

    //-     li.breadcrumbs__item
    //-       a.breadcrumbs__link
    //-         span Контакты

    .contact__wrap
      h2 Контакты

      address.address
        .address__item
          h4 Общие вопросы
          p
            a(href="tel:+78005559953") 8 800 555 99 53
          p 
            a(href="mailto:info@aitek.ru") info@aitek.ru
          a.ico.telegram(href="#tel")
            +svg("telegram3")
            span telegram
          a.ico.viber(href="#viber")
            +svg("viber")
            span viber
          a.ico.whatsapp(href="#whatsapp")
            +svg("whatsapp")
            span whatsapp
          
        .address__item
          h4 Работа в АйТек
          p 
            a(href="tel:+79590504041") 8 959 050 40 41, доб 4859
          p 
            a(href="mailto:hr@aitek.ru") hr@aitek.ru

        .address__item
          h4 Техническая поддержка
          p 
            a(href="tel:+78005559953") 8 800 555 99 53
          p 
            a(href="mailto:info@aitek.ru") info@aitek.ru
          a.ico.telegram(href="#telegram")
            +svg("telegram3")
            span telegram

      .contact-tab.js-tab
        .contact-tab__head
          each text,index in ["Владимир", "Иваново", "Нижний Новгород", "Склад и Сервисный центр"]
            button.js-tab-btn(data-text=text class=index === 0 ? 'active' : '')
              span=text

        .contact-tab__contact
          each i in [1,2,3,4]
            .contact-tab__item.js-tab-content(class=i === 1 ? 'active' : '')
              div
                h3 Офис г. Владимир #{i}
                ul
                  li
                    em Адрес
                    span 11745 улица Дорожная дом 70б
                    small Отдельный вход с левой стороны здания (со стороны ул. Мира) 3-й этаж

                  li
                    em Телефон
                    a(href="tel:89590504041") 8 959 050 40 41

              div.map(data-map="map"+i)
                div.map__item(id="map"+i)

      script(src="https://api-maps.yandex.ru/2.1/?apikey=55a53236-c7d6-45ea-a8d9-bc51cda5db7c&load=Map&lang=ru_RU" type="text/javascript")
      script.
        (function () {
          let id = [].slice.call(document.querySelectorAll("[data-map]"));

          id.forEach(item => {
            let data = item.dataset.map;

            ymaps.ready(function () {
              var map = new ymaps.Map(data, {
                center: [55.76, 37.64],
                zoom: 10
              });

              if (map) {
                ymaps.modules.require(['Placemark', 'Circle'], function (Placemark, Circle) {
                  var placemark = new Placemark([55.37, 35.45]);
                });
              }
            });
          });
        })();
