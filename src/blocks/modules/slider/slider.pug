.headslid
    .headslid__wrap.h-full

      // Slider main container
      .swiper-container.h-inherit.js-headslider

        // Additional required wrapper
        .swiper-wrapper
          // Slides
          .swiper-slide
            .container-fluid.h-full
              .headslid__item
                .headslid__item-content
                  h1 АйТек - Amplify Power 
                    b.text-gradient.--pl-none Partner компании
                    | HP Inc
                  p Компания «АйТек» подтвердила партнерский статус  HP на 2021 год
                  a.btn
                    span Подробнее
            img(src="img/slider-img-1.svg" alt="img")

          .swiper-slide
            .container-fluid.h-full
              .headslid__item
                .headslid__item-content
                  h1
                    b.text-gradient.--pl-none Поддержка
                    | IT инфраструктуры
                  p Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
                  a.btn
                    span Подробнее
            img(src="img/slider-img-2.svg" alt="img")

          .swiper-slide
            .container-fluid.h-full
              .headslid__item
                .headslid__item-content
                  h1
                    b.text-gradient.--pl-none Инженерные
                    br
                    | системы и сети
                  p От проекта небольшой сети до строительства ЦОД
                  button.btn
                    span Подробнее
            img(src="img/slider-img-3.svg" alt="img")

        // If we need pagination
        .swiper-pagination.js-headslider-pagination
