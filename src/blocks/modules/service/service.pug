section.service
    .container-fluid
        .service__wrap
            h2.--bold Услуги

            .service__grid
                .service__item
                    i
                        +svg("servers")
                    h3 ИТ Инфраструктура
                    ul
                        li Центры
                            br
                            | обработки данных
                        li Серверные решения и СХД
                        li Сетевая инфраструктура
                        li Инфраструктура виртуальных рабочих мест

                .service__item
                    i
                        +svg("broken-cable")
                    h3 Инженерные системы
                    ul
                        li Системы
                            br
                            | передачи данных
                        li Системы
                            br
                            | электроснабжения
                        li Видеостены
                            br
                            | и конференц - залы
                        li Телефония
                            br
                            | и видеоконференции

                .service__item
                    i
                        +svg("setting")
                    h3 Сервис и ИТ-Аутсорсинг
                    ul
                        li ИТ Аутсорсинг
                        li Аренда и
                            br
                            | обслуживание
                            br
                            | печатной техники
                        li Ремонт
                            br
                            |компьютерной
                            br
                            | техники
                        li Гарантийное
                            br
                            |  обслуживание

                .service__item
                    i
                        +svg("protection")
                    h3 Системы безопасности
                    ul
                        li Видеонаблюдение
                        li Системы контроля
                            br
                            | доступа
                        li Охранная - пожарная
                            br
                            | сигнализация
                        li Охранные системы
