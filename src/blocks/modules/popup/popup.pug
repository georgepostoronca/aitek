button(class="btn btn--primary btn-demo js-tingle-modal" data-slider="tingle-slider") A simple modal
button(class="btn btn--primary btn-demo js-tingle-modal" data-slider="tingle-repair")
    span A simple modal
button(class="btn btn--primary btn-demo js-tingle-modal" data-slider="tingle-img")
    span IMG

.tingle.--min.tingle-form
    .tingle__close.js-modal-close
        <svg viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg"><path d="M.3 9.7c.2.2.4.3.7.3.3 0 .5-.1.7-.3L5 6.4l3.3 3.3c.2.2.5.3.7.3.2 0 .5-.1.7-.3.4-.4.4-1 0-1.4L6.4 5l3.3-3.3c.4-.4.4-1 0-1.4-.4-.4-1-.4-1.4 0L5 3.6 1.7.3C1.3-.1.7-.1.3.3c-.4.4-.4 1 0 1.4L3.6 5 .3 8.3c-.4.4-.4 1 0 1.4z" fill="#000" fill-rule="nonzero"></path></svg>
    h3.--min Обратная связь
    form
        input(type="text" placeholder="Имя" minlength="3" name="name" pattern="[A-Za-z0-9]+" required)
        input.js-input-phone(type="text" placeholder="Телефон" name="name" required)
        input(type="text" placeholder="Email" name="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$" required)

        textarea(placeholder="Сообщение" name="message" minlength="3" required)

        label(for="input-1").input-checbox
            input(type="checkbox" name="check" id="input-1" required)
            span Согласие на обработку данных

        button.btn
            span Отправить


.tingle.--max.tingle-repair
    .tingle__close.js-modal-close
        <svg viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg"><path d="M.3 9.7c.2.2.4.3.7.3.3 0 .5-.1.7-.3L5 6.4l3.3 3.3c.2.2.5.3.7.3.2 0 .5-.1.7-.3.4-.4.4-1 0-1.4L6.4 5l3.3-3.3c.4-.4.4-1 0-1.4-.4-.4-1-.4-1.4 0L5 3.6 1.7.3C1.3-.1.7-.1.3.3c-.4.4-.4 1 0 1.4L3.6 5 .3 8.3c-.4.4-.4 1 0 1.4z" fill="#000" fill-rule="nonzero"></path></svg>

    .tingle-repair__head
        h4 Плановый срок ремонта не более:
            span 35 рабочих дней
        p Это максимальный срок, учитывающий различныес ценарии и нормативы сервисного центра. Срок ремонта может быть изменен в случаях ремонта во внешнем сервисном центре.

    form.tingle-repair__content
        h2.--fw-700 Заявка на ремонт

        .tingle-repair__check
            - var radios = ["Негарантийный ремонт", "Гарантийный ремонт", "Гарантийный ремонт (Системный блок АйТек)", "Владимир", "Вл. область и другие регионы"]
            for radio, index in radios
                div
                    label(for="input-radio-"+index).input-checbox.--radio
                        input(type="radio" name="radio" id="input-radio-"+index)
                        span=radio

        .tingle-repair__form
            input(type="text" placeholder="Компания" name="company" required)
            input(type="text" placeholder="Наименование товара" name="name-prod" required)
            input(type="text" placeholder="Контактное лицо" name="contact" required)
            input(type="text" placeholder="Заявленная неисправность" name="zaiav-neispr" required)
            input.js-input-phone(type="phone" placeholder="Телефон для связи" name="name" required)
            input(type="text" placeholder="Серийный номер товара" name="name" required)
            input(type="email" placeholder="Email" name="email" required)
            input(type="text" placeholder="Номер документа о покупке" name="number-doc" required)
            textarea(placeholder="Комментарий" name="message" minlength="3" required)

            div
                button.btn
                    span Отправить


.tingle.--max.tingle-img
    .tingle-img__head
        h4 Гарантий ремонт
        span (кроме системных блоков АйТек):
    .tingle-img__content
        img(src="./img/remont.jpg" srcset="img/remont@2x.jpg 2x" alt="IMG")
