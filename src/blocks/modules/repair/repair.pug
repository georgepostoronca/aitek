section.repair
    .container-fluid
        //- .content__top
        //-     ul.breadcrumbs
        //-         li.breadcrumbs__item
        //-             a.breadcrumbs__link(href="/")
        //-                 span Главная

        //-         li.breadcrumbs__item
        //-             a.breadcrumbs__link(href="/support.html")
        //-                 span Сервис и поддержка

        //-         li.breadcrumbs__item
        //-             a.breadcrumbs__link
        //-                 span Сроки ремонта

        .repair__wrap
            .repair__head
                h1.h2 Сроки ремонта

            .repair__grid
                .repair__grid-item
                    b Гарантийный ремонт
                    span (кроме системных блоков АйТек):
                    div
                        span
                            b 45 - 50
                            | рабочих дней
                    button.btn.--light(data-fancybox data-src="#tingle-img")
                        span Подробнее на схеме

                .repair__grid-item
                    b Негарантийный ремонт
                    span
                    div
                        span
                            b 45 - 50
                            | рабочих дней
                    button.btn.--light(data-fancybox data-src="#tingle-img")
                        span Подробнее на схеме

                .repair__grid-item
                    b Гарантийный ремонт
                    span (кроме системных блоков АйТек):
                    div
                        span
                            b 45 - 50
                            | рабочих дней
                    button.btn.--light(data-fancybox data-src="#tingle-img")
                        span Подробнее на схеме

            .repair__request
                h3.h3 Заявка на ремонт
                form.repair__request-wrapper
                    .repair__request-radios
                        .repair__request-type
                            p Тип ремонта:
                            label
                                input(type="radio" name='type' value='10')
                                | Негарантийный ремонт
                            label
                                input(type="radio" name='type' value='30')
                                | Гарантийный ремонт
                            label
                                input(type="radio" name='type' value='5')
                                | Гарантийный ремонт (Системный блок Айтек)

                        .repair__request-location
                            p Ваше местоположение:
                            label
                                input(type="radio" name='location' value='5')
                                | Владимир
                            label
                                input(type="radio" name='location' value='10')
                                | Вл. область и другие регионы

                    .repair__request-text
                        p Плановый срок ремонта не более:
                            strong
                                span.repair__request-days 15
                                |  рабочих дней.
                        small Это максимальный срок, учитывающий различные сценарии и нормативы сервисного центра. * Срок ремонта может быть изменен в случаях ремонта во внешнем сервисном центре.

                    .repair__request-inputs
                        input(placeholder='Компания')
                        input(placeholder='Контактное лицо')
                        input(placeholder='Телефон для связи')
                        input(placeholder='Ваш e-mail')
                        input(placeholder='Наименование товара (модель)')
                        input(placeholder='Заявленная неисправность')
                        input(placeholder='Серийный номер товара')
                        #docnum
                            input(placeholder='Номер документа о покупке')
                        textarea(placeholder='Комментарий' style="resize: none;")
                    button(type="submit").btn
                        span Отправить

