section.parteners
    .container-fluid
        .parteners__wrap
            .parteners-grid
                h1.h2.--fw-700 Партнеры

                .parteners-grid__wrap
                    .parteners-grid__scroll(onscroll="scrolledFn(this, true)")
                        each i in [1,2,3]
                            .parteners-grid__item
                                picture
                                    img(src="img/amocrm-logo-white1.jpg" srcset="img/amocrm-logo-white1@2x.jpg 2x" alt="IMG")
                                b amoCRM
                                span
                                    b Статус:
                                    | Партнер 2 уровня
                                .parteners-grid__link
                                .parteners-grid__link
                                    a.blue(href="#Сертификат" data-fancybox data-src="#tingle-slider") www.amocrm.ru

                            .parteners-grid__item
                                picture
                                    img(src="img/3_1_061.jpg" srcset="img/3_1_061@2x.jpg 2x" alt="IMG")
                                b amoCRM
                                span
                                    b Статус:
                                    | Register Partner
                                .parteners-grid__link
                                    a.silver(href="#Сертификат" data-fancybox data-src="#tingle-slider") Сертификат
                                .parteners-grid__link

                            .parteners-grid__item
                                picture
                                    img(src="img/53451da94eaa4_lenovo-logomaxresdefaultjpg-4ov8am1u1.jpg" srcset="img/53451da94eaa4_lenovo-logomaxresdefaultjpg-4ov8am1u1@2x.jpg 2x" alt="IMG")
                                b amoCRM
                                span
                                    b Статус:
                                    | DATA CENTER Авторизованный партнер, PC GOLD PARTNER
                                .parteners-grid__link
                                    a.silver(href="#Сертификат" data-fancybox data-src="#tingle-slider") Сертификат
                                .parteners-grid__link
                                    a.blue(href="#Сертификат") www.amocrm.ru

                            .parteners-grid__item
                                picture
                                    img(src="img/oki1.jpg" srcset="img/oki1@2x.jpg 2x" alt="IMG")
                                b amoCRM
                                span
                                    b Статус:
                                    | Официальный дилер
                                .parteners-grid__link
                                    a.silver(href="#Сертификат" data-fancybox data-src="#tingle-slider") Сертификат
                                .parteners-grid__link

                            .parteners-grid__item
                                picture
                                    img(src="img/t25_beward1.jpg" srcset="img/t25_beward1@2x.jpg 2x" alt="IMG")
                                b amoCRM
                                span
                                    b Статус:
                                    | Партнер 2 уровня
                                .parteners-grid__link
                                    a.silver(href="#Сертификат" data-fancybox data-src="#tingle-slider") Сертификат
                                .parteners-grid__link
                    a(href="#link").link-more
                        +svg("arrowline")
                        span Показать еще

            .parteners-service
                h2.--fw-700 Сервисные авторизации
                .parteners-service__table
                    .table(cellspacing="0" cellpadding="0")
                        .tr
                            .td
                                b АРС
                            .td
                                span Статус вендора
                            .td
                                ul
                                    li Источники бесперебойного питания серий Back, BackPro, Smart
                                    li Сменные комплекты батарей SYBT2 для серии Symmetra
                                    li Сетевые фильтры
                            .td.last
                                a(href="Сертификаты" data-fancybox data-src="#tingle-slider") Сертификаты

                        .tr
                            .td
                                b НР
                            .td
                                span Статус вендора
                            .td
                                ul
                                    li Компьютеры
                                    li Ноутбуки бизнес серии
                                    li Мониторы
                                    li Тонкие клиенты для коммерческого сектора
                                    li Лазерные принтеры малой и средней производительности.
                                    li IBM
                            .td.last
                                a(href="Сертификаты" data-fancybox data-src="#tingle-slider") Сертификаты

                        .tr
                            .td
                                b IBM
                            .td
                                span Статус вендора
                            .td
                                ul
                                    li Cервера стандартной архитектуры
                                    li Cистемы хранения данных
                            .td.last
                                a(href="Сертификаты" data-fancybox data-src="#tingle-slider") Сертификаты

                .parteners-service__btn
                    a(href="#link").link-more
                        +svg("arrowline")
                        span Показать еще



